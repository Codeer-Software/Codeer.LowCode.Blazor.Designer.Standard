<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <!-- DDLWindow 等の WPF Window を含むため -->
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Codeer.LowCode.Blazor.Designer.Standard</AssemblyName>
        <RootNamespace>Codeer.LowCode.Blazor.Designer.Standard</RootNamespace>

        <!-- OSS / NuGet パッケージ (MIT)。 -->
        <PackageId>Codeer.LowCode.Blazor.Designer.Standard</PackageId>
        <Version>0.8.2</Version>
        <PackageReleaseNotes>
- New headless verb `developer-workspace "&lt;host root&gt;"`: writes the host-development specs (HostCustomization.md, _FieldCommon.md, ScriptExtensions.md) to `&lt;host root&gt;/ClaudeCodeForDeveloper/_specs/` for Claude Code sessions that edit the C# host solution. Works without a design project and only owns the `_`-prefixed entries of that folder (static documents shipped by the host, e.g. Codeer.LowCode.Blazor.Starter's setup procedure, live next to them).
- Claude Code workspace: the default design project folder name is now `design` (was `Design`); the workspace is one design project's working folder (Project.md / ddl / docs / design), which also creates `docs/`. Rules updated: confirm the base before building a business app on a sample/showcase/business-template project (propose a new Empty / EmptyAuth project instead), confirm core business requirements (approval route, roles, tax/rounding, numbering) before defaulting them, lead completion reports with what the user receives, and describe the `DesignProjects/&lt;name&gt;/` layout used when living next to a host solution.
- Reference updated to Codeer.LowCode.Blazor.Designer 1.3.25.
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Company>Codeer Software</Company>
        <Authors>Codeer Software</Authors>
        <Title>Codeer.LowCode.Blazor.Designer.Standard</Title>
        <PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Designer.Standard</PackageProjectUrl>
        <PackageTags>Blazor;LowCode;Codeer;Designer;AI</PackageTags>
        <Description>Standard implementation for the Codeer.LowCode.Blazor Designer: project templates, tool menus (DDL generation, DB import, class generation, Excel cheat sheet, Selenium page objects), and an AI chat assistant (model-swappable via Microsoft.Extensions.AI IChatClient). Register everything with one call or pick features individually.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Designer.WpfApp.Test" />
    </ItemGroup>

    <ItemGroup>
        <!-- 雛形フォルダは配布物 (zip) であり、このライブラリのソースではない -->
        <Compile Remove="SeleniumTestTemplate\**" />
        <None Remove="SeleniumTestTemplate\**" />
        <EmbeddedResource Remove="SeleniumTestTemplate\**" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Codeer.LowCode.Blazor.Designer" Version="1.3.25" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
        <!-- ExcelCheatSheet 用 -->
        <PackageReference Include="ClosedXML" Version="0.105.0" />
    </ItemGroup>

    <!-- プロジェクトテンプレート(zip)とサンプルDB、アイコン一覧。
         LogicalName は StandardTemplates / StandardIcons の GetManifestResourceStream と連動。 -->
    <ItemGroup>
        <EmbeddedResource Include="Templates\Resources\*">
            <LogicalName>Codeer.LowCode.Blazor.Designer.Standard.Templates.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icons\bootstrap_icons.txt">
            <LogicalName>Codeer.LowCode.Blazor.Designer.Standard.Icons.bootstrap_icons.txt</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Claude Code ワークスペース (ClaudeWorkspace/ 配下のプロンプト・Docs・フック一式) を
         ビルド時に zip 化して埋め込む。LogicalName は ClaudeWorkspace.ResourceName と連動。
         リポジトリでは素のファイルとして編集し、配布はデザイナの claude-workspace verb / メニューが展開する。 -->
    <Target Name="ZipClaudeWorkspace" BeforeTargets="BeforeBuild">
        <ZipDirectory SourceDirectory="ClaudeWorkspace" DestinationFile="$(IntermediateOutputPath)ClaudeWorkspace.zip" Overwrite="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)ClaudeWorkspace.zip">
                <LogicalName>Codeer.LowCode.Blazor.Designer.Standard.ClaudeWorkspace.zip</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

    <!-- Selenium テストプロジェクトの雛形 (SeleniumTestTemplate/LowCodeApp.SeleniumTest) も同じ方式で zip 化して埋め込む。
         selenium-test-init verb が展開し "LowCodeApp" をアプリ名に置き換える。雛形自体はこのプロジェクトのビルド対象ではない。 -->
    <Target Name="ZipSeleniumTestTemplate" BeforeTargets="BeforeBuild">
        <ZipDirectory SourceDirectory="SeleniumTestTemplate" DestinationFile="$(IntermediateOutputPath)SeleniumTestTemplate.zip" Overwrite="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)SeleniumTestTemplate.zip">
                <LogicalName>Codeer.LowCode.Blazor.Designer.Standard.SeleniumTestTemplate.zip</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

</Project>
