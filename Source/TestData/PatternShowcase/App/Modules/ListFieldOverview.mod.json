      "Style": "H5",
      "Name": "Ex5Label",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "カラムヘッダを右クリックでポップアップ → 列の表示/非表示を切替。ヘッダをドラッグで列順序入替。変更はブラウザのストレージに記憶される。",
      "Name": "Ex5Note",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "CanNavigateToDetail": true,
      "CanCustomizeColumns": true,
      "DisplayName": "タスク一覧 (列カスタマイズ可)",
      "SearchCondition": {
        "LimitCount": 50,
        "ModuleName": "ListSampleItems",
        "Condition": {
          "Name": "",
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.MultiMatchCondition"
        }
      },
      "PagerPosition": "Bottom",
