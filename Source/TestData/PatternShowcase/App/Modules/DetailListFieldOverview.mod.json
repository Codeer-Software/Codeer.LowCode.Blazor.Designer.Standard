{
  "Name": "DetailListFieldOverview",
  "DataSourceName": "PatternsSQLite",
  "DbTable": "DetailListDemoParent",
  "Fields": [
    {
      "Target": "HistoryBack",
      "Icon": "bi bi-arrow-left-circle-fill",
      "TitleText": "",
      "Name": "BackButton",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.AnchorTagFieldDesign"
    },
    {
      "DbColumn": "Id",
      "Name": "Id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.IdFieldDesign"
    },
    {
      "DbColumn": "Title",
      "DisplayName": "タイトル",
      "Name": "Title",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Text": "DetailListField 解説",
      "Style": "H4",
      "Name": "PageTitle",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "用途",
      "Style": "H5",
      "Name": "H_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親レコードの詳細画面に明細リスト (子レコード群) をインライン表示・編集するField。",
      "Name": "P_0_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "受注ヘッダ + 受注明細、見積 + 見積行 など 1:N 親子関係でよく使う。",
      "Name": "P_0_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "ListField との違い",
      "Style": "H5",
      "Name": "H_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "DetailListField は親の Submit と同時に子の挿入/更新/削除も一括コミットされる。",
      "Name": "P_1_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "ListField は独立した一覧 (検索結果、別レコードへのリンク先)。",
      "Name": "P_1_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "DetailListField の各行は親 Module の状態と同じ Submit 単位 (＝同一トランザクション)。",
      "Name": "P_1_2",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親子削除 (DeleteTogether)",
      "Style": "H5",
      "Name": "H_2",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "DeleteTogether=true で親削除時に子レコードも削除される (デフォルト true)。",
      "Name": "P_2_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親子関係 (SearchCondition)",
      "Style": "H5",
      "Name": "H_3",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親PK = 子FK を FieldVariableMatchCondition で記述する。",
      "Name": "P_3_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親の新規作成時、子は親PKがまだ無いのでテンポラリIDで管理される (フレームワーク内部処理)。",
      "Name": "P_3_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "CRUD 制御",
      "Style": "H5",
      "Name": "H_4",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "CanCreate/CanUpdate/CanDelete は ListField と同じ。デフォルト true (詳細画面では編集UI出す)。",
      "Name": "P_4_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "明細追加ボタンが行末に出る。各行の右端で削除ボタン。",
      "Name": "P_4_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "以下、実例",
      "Style": "H5",
      "Name": "H_5",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "下の DetailListField は DetailListDemoChild テーブルの子レコードを 親PK = 子FK で絞り込んで表示している。明細を追加・更新・削除できる。",
      "Name": "P_5_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "",
      "RelativeField": "Title",
      "Name": "TitleLabel",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "例: 親 'デモ' レコードの明細リスト (DetailListField)",
      "Style": "H5",
      "Name": "ExLabel",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "DisplayName": "明細",
      "SearchCondition": {
        "ModuleName": "DetailListDemoChild",
        "Condition": {
          "Children": [
            {
              "SearchTargetVariable": "ParentId.Value",
              "Variable": "Id.Value",
              "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldVariableMatchCondition"
            }
          ],
          "Name": "",
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.MultiMatchCondition"
        }
      },
      "PagerPosition": "Bottom",
      "DeleteTogether": true,
      "CanCreate": true,
      "CanUpdate": true,
      "CanDelete": true,
      "Name": "Items",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.DetailListFieldDesign"
    }
  ],
