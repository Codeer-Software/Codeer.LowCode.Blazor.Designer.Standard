{
  "Name": "TileListFieldOverview",
  "CanCreate": false,
  "CanDelete": false,
  "Fields": [
    {
      "Target": "HistoryBack",
      "Icon": "bi bi-arrow-left-circle-fill",
      "TitleText": "",
      "Name": "BackButton",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.AnchorTagFieldDesign"
    },
    {
      "Text": "TileListField 解説",
      "Style": "H4",
      "Name": "PageTitle",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "用途",
      "Style": "H5",
      "Name": "H_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "レコードをタイル (カード) 形式でグリッド表示するField。",
      "Name": "P_0_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "商品一覧 (画像つき)、ダッシュボードのカード並び、ギャラリー等の表現に使う。",
      "Name": "P_0_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "ListField との違い",
      "Style": "H5",
      "Name": "H_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "ListField は表形式の行ベース、TileListField はカード形式のタイルベース。",
      "Name": "P_1_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "TileWidth でタイル1個の幅 (px) を指定。コンテナ幅に応じて自動で折返し。",
      "Name": "P_1_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "各タイルが独立した DetailLayout 描画 (LayoutName で指定可) を持つ。",
      "Name": "P_1_2",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親子関係 / ページング / CRUD",
      "Style": "H5",
      "Name": "H_2",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "親子フィルタ・ページング・CRUD制御は ListField とほぼ共通。",
      "Name": "P_2_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "CanSelect=true で選択ハイライト (タイル全体)、CanNavigateToDetail=true で詳細遷移可。",
      "Name": "P_2_1",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "以下、実例",
      "Style": "H5",
      "Name": "H_3",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "LookupCustomer の DetailLayout をタイル幅 220px で並べる。",
      "Name": "P_3_0",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "例: 顧客タイル (TileWidth=220, FillSpaces=true)",
      "Style": "H5",
      "Name": "ExLabel",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "TileWidth": 220,
      "FillSpaces": true,
      "DisplayName": "顧客タイル",
